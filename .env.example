# Postgres connection string. This value matches compose.yaml.
DATABASE_URL=postgres://stuff:stuff@127.0.0.1:5433/stuff

# Login password hash. Generate with `pnpm hash-password`.
APP_PASSWORD_HASH=

# OpenRouter API key, used to turn voice captures into items.
# Without it, captures are saved and marked as failed until retried.
OPENROUTER_API_KEY=
